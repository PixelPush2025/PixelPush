{
  "name": "pixelpush-calling-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel Push AI calling agent (inbound + outbound, Hindi + English) on Vapi",
  "type": "module",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "setup": "node --env-file-if-exists=.env scripts/setup.js",
    "call": "node --env-file-if-exists=.env scripts/call.js",
    "test": "node --test test/*.test.js"
  }
}
