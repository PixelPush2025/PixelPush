# --- Vapi (https://dashboard.vapi.ai -> API Keys -> Private key) ---
VAPI_API_KEY=

# Phone number imported/bought in Vapi (dashboard -> Phone Numbers -> copy the ID)
VAPI_PHONE_NUMBER_ID=

# Public HTTPS URL of this server (e.g. your ngrok / Render / Railway URL), no trailing slash
PUBLIC_URL=https://your-server.example.com

# Shared secret Vapi sends in the x-vapi-secret header; pick any long random string
VAPI_WEBHOOK_SECRET=change-me

# Filled in by `npm run setup` (it prints them) - paste them here afterwards
VAPI_INBOUND_ASSISTANT_ID=
VAPI_OUTBOUND_ASSISTANT_ID=

# --- Voice / brain (optional overrides) ---
# Claude model Vapi should use; pick one listed under Anthropic in the Vapi dashboard
LLM_MODEL=claude-sonnet-5-5
# ElevenLabs voice ID (pick a Hindi-capable voice in the Vapi/ElevenLabs voice library)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Business ---
AGENT_NAME=Priya
BUSINESS_NAME=Pixel Push
BUSINESS_EMAIL=hello@pixelpush.marketing
# Optional: your Calendly / booking link, sent to leads after a meeting is requested
BOOKING_LINK=
# Where the server writes leads/meetings/messages/call reports
DATA_DIR=./data
PORT=3000
